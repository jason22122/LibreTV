{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "libretv-next"
    }
  ],
  "vars": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "SEARCH_MAX_PAGES": "2",
    "SEARCH_SOURCE_TIMEOUT_MS": "10000",
    "DEFAULT_SOURCES": "[{\"name\":\"电影天堂资源\",\"url\":\"http://caiji.dyttzyapi.com/api.php/provide/vod\",\"detail\":\"http://caiji.dyttzyapi.com\",\"key\":\"env_0\"},{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"key\":\"env_2\"},{\"name\":\"非凡影视\",\"url\":\"http://ffzy5.tv/api.php/provide/vod\",\"detail\":\"http://ffzy5.tv\",\"key\":\"env_3\"},{\"name\":\"360资源\",\"url\":\"https://360zy.com/api.php/provide/vod\",\"key\":\"env_4\"}]"
  }
}

