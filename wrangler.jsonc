{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "libretv-next"}],
  "vars": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "SEARCH_MAX_PAGES": "2",
    "SEARCH_SOURCE_TIMEOUT_MS": "10000",
    "DEFAULT_SOURCES": "[{\"name\":\"电影天堂资源\",\"url\":\"http://caiji.dyttzyapi.com/api.php/provide/vod\",\"detail\":\"http://caiji.dyttzyapi.com\"},{\"name\":\"如意资源\",\"url\":\"https://cj.rycjapi.com/api.php/provide/vod\"},{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\"},{\"name\":\"非凡影视\",\"url\":\"http://ffzy5.tv/api.php/provide/vod\",\"detail\":\"http://ffzy5.tv\"},{\"name\":\"360资源\",\"url\":\"https://360zy.com/api.php/provide/vod\"},{\"name\":\"iqiyi资源\",\"url\":\"https://www.iqiyizyapi.com/api.php/provide/vod\"},{\"name\":\"极速资源\",\"url\":\"https://jszyapi.com/api.php/provide/vod\",\"detail\":\"https://jszyapi.com\"},{\"name\":\"魔都资源\",\"url\":\"https://www.mdzyapi.com/api.php/provide/vod\"},{\"name\":\"最大资源\",\"url\":\"https://api.zuidapi.com/api.php/provide/vod\"},{\"name\":\"百度云资源\",\"url\":\"https://api.apibdzy.com/api.php/provide/vod\"},{\"name\":\"无尽资源\",\"url\":\"https://api.wujinapi.me/api.php/provide/vod\"},{\"name\":\"iKun资源\",\"url\":\"https://ikunzyapi.com/api.php/provide/vod\"}]"
  }
}

